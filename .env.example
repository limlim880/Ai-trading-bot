# Copy this file to .env and fill in real values.
# NEVER commit the real .env file -- it is already listed in .gitignore.

APP_ENV=development
PORT=8000
LOG_LEVEL=INFO

# Path to the SQLite database file.
# In production (Railway) this MUST point inside the mounted volume,
# e.g. /data/trading_assistant.db -- see DEPLOYMENT.md.
DATABASE_PATH=trading_assistant.db

# Shared secret TradingView must include in every webhook payload's
# "secret" field. Generate a long random string, e.g. with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Reject TradingView payloads older (or further in the future) than this
# many seconds -- protects against stale/replayed webhook calls.
WEBHOOK_MAX_AGE_SECONDS=300

# Requests per minute allowed per client IP on the webhook endpoints.
RATE_LIMIT_PER_MINUTE=30

# Telegram bot -- create a bot with @BotFather to get a token, and message
# @userinfobot (or your bot) to find your numeric chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Account / risk configuration
ACCOUNT_BALANCE=10000
RISK_PER_TRADE_PERCENT=0.5
MAX_DAILY_LOSS_PERCENT=1.0
MAX_WEEKLY_LOSS_PERCENT=3.0
MAX_CONCURRENT_TRADES=2
MIN_RISK_REWARD=2.0
MIN_SIGNAL_SCORE=75

# Naive wall-clock expiry window (Stage 2 will replace this with
# trading-time-aware expiry).
PENDING_SIGNAL_EXPIRY_HOURS=48

MONITOR_INTERVAL_SECONDS=300
